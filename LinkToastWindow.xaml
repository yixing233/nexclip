<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NexClip.Desktop.LinkToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NexClip.Desktop.Services">
    <Border x:Name="RootBorder" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
        CornerRadius="10" Padding="16,14,16,14">
        <StackPanel Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="{x:Bind services:Lucide.ExternalLink}" Width="15" Height="15" />
                    <TextBlock Text="已复制链接" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="OpenHotkeyText" Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="UrlText" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Click="Open_Click" Style="{StaticResource AccentButtonStyle}" Padding="12,6" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="{x:Bind services:Lucide.ExternalLinkWhite}" Width="13" Height="13" />
                        <TextBlock Text="打开链接" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="Close_Click" Padding="10,6" Background="Transparent" BorderThickness="0" MinHeight="32">
                    <TextBlock Text="忽略" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
