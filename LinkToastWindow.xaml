<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NexClip.Desktop.LinkToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NexClip.Desktop.Services">
    <Grid x:Name="RootGrid"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        Padding="18,16,18,16"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        KeyDown="RootGrid_KeyDown">
        <StackPanel Spacing="12">
            <!-- 顶栏：图标徽标 + 标题 + 右上角实时倒计时/热键一体胶囊 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Image x:Name="TypeIcon" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右上角倒计时与热键状态胶囊 (不挤占底栏按钮空间) -->
                <Border Grid.Column="1" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8,4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Image x:Name="ClockIcon" Width="11" Height="11" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountdownBadgeText" Text="5s" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpenHotkeyText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 中部内容区：优雅微质感圆角卡片，包裹 URL、路径、提取码或色彩微预览 -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 色值场景专属色块微预览 -->
                    <Border
                        x:Name="ColorPreviewBorder"
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <!-- 提取码微胶囊 (网盘场景) -->
                        <Border
                            x:Name="ExtractionCodePill"
                            HorizontalAlignment="Left"
                            Background="#1D2563EB"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Visibility="Collapsed">
                            <TextBlock x:Name="ExtractionCodeText" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                        </Border>

                        <!-- 主副标题 / 路径 / URL 文本 -->
                        <TextBlock
                            x:Name="SubtitleText"
                            FontSize="12"
                            FontFamily="Cascadia Code, Segoe UI Variable, Segoe UI"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部操作栏：全宽右对齐高对比度操作按钮 (无重叠隐患) -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,2,0,0">
                <!-- 次要操作按钮 (如复制 Git Clone、复制提取码、复制 HSL 等) -->
                <Button x:Name="SecondaryActionButton" Click="SecondaryAction_Click" CornerRadius="6" Padding="12,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" MinHeight="32" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Image x:Name="SecondaryButtonImage" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="SecondaryButtonLabel" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 主要操作按钮 (Enter 默认执行，亮蓝底纯白字高对比度) -->
                <Button x:Name="PrimaryActionButton" Click="PrimaryAction_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="14,6" MinHeight="32" Background="#2563EB" BorderThickness="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2563EB" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1D4ED8" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1E40AF" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Image x:Name="PrimaryButtonImage" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="PrimaryButtonLabel" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 忽略关闭按钮 (Esc) -->
                <Button Click="Close_Click" CornerRadius="6" Padding="10,6" Background="Transparent" BorderThickness="0" MinHeight="32">
                    <TextBlock Text="忽略 (Esc)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
