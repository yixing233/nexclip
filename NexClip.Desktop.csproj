<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NexClip.Desktop</RootNamespace>
    <AssemblyName>NexClip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>20260825.01</Version>
    <AssemblyVersion>2026.8.25.1</AssemblyVersion>
    <FileVersion>2026.8.25.1</FileVersion>
    <InformationalVersion>20260825.01</InformationalVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);tmp\**;backup\**;server\**;server-node\**;android\**;web\**;syncclipboard-client\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\lucide\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- 排除嵌套的 NexClip.Tray 子项目源码与 obj/bin 生成物:默认 Compile 通配会把它们连同自身 obj 里的 AssemblyInfo 一起编进主程序集,造成重复类型/重复特性 -->
    <Compile Remove="NexClip.Tray\**\*.cs" />
    <EmbeddedResource Remove="NexClip.Tray\**\*.resx" />
    <None Remove="NexClip.Tray\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- UIAutomationClient:粘贴时用 UIA 定位目标输入框,精确重建焦点 -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="NexClip.Tray\NexClip.Tray.csproj" />
  </ItemGroup>
</Project>
