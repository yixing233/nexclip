<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NexClip.Desktop</RootNamespace>
    <AssemblyName>NexClip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>20260904.01</Version>
    <AssemblyVersion>2026.9.4.1</AssemblyVersion>
    <FileVersion>2026.9.4.1</FileVersion>
    <InformationalVersion>20260904.01</InformationalVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>zh-Hans;zh-CN;en-US;en</SatelliteResourceLanguages>
    <!-- 常驻托盘应用的内存策略:保留后台(并发)GC 以保证 Alt+V 呼出的交互响应,
         降低驻留内存改用 System.GC.ConserveMemory(见下方 RuntimeHostConfigurationOption) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);tmp\**;backup\**;server\**;server-node\**;android\**;web\**;syncclipboard-client\**;NexClip.Installer.Native\**;NexClip.Installer.Native.Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- 内存节约模式:让 GC 更积极地归还已提交内存,常驻托盘场景下显著降低驻留内存(0-9,5 为均衡值) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\lucide\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- 排除嵌套的 NexClip.Tray 子项目源码与 obj/bin 生成物:默认 Compile 通配会把它们连同自身 obj 里的 AssemblyInfo 一起编进主程序集,造成重复类型/重复特性 -->
    <Compile Remove="NexClip.Tray\**\*.cs" />
    <EmbeddedResource Remove="NexClip.Tray\**\*.resx" />
    <None Remove="NexClip.Tray\**" />
    <!-- 测试项目同样位于 desktop 下，必须从主 WinUI 项目的默认通配项中排除 -->
    <Compile Remove="NexClip.Tray.Tests\**\*.cs" />
    <EmbeddedResource Remove="NexClip.Tray.Tests\**\*.resx" />
    <None Remove="NexClip.Tray.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- UIAutomationClient:粘贴时用 UIA 定位目标输入框,精确重建焦点 -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="NexClip.Tray\NexClip.Tray.csproj" />
  </ItemGroup>
  <Target Name="GenerateResourcesPri" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFiles="$(TargetDir)resources.pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>
  <Target Name="CopyPriAndXbfToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    <Copy SourceFiles="$(TargetDir)resources.pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)resources.pri')" />
    <ItemGroup>
      <_XbfFiles Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfFiles)" DestinationFolder="$(PublishDir)%(RecursiveDir)" Condition="Exists('%(FullPath)')" />
  </Target>
</Project>
