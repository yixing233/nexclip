<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NexClip_Setup</AssemblyName>
    <RootNamespace>NexClip.Installer.Native</RootNamespace>
    <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
    <Version>20260905.01</Version>
    <AssemblyVersion>2026.9.5.1</AssemblyVersion>
    <FileVersion>2026.9.5.1</FileVersion>
    <InformationalVersion>20260905.01</InformationalVersion>
    
    <!-- Native AOT 纯机器码编译 -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OptimizationPreference>Size</OptimizationPreference>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 运行环境依赖清单（固定下载地址 + SHA-256）由 installer\setup-dependencies.json 单点维护 -->
    <EmbeddedResource Include="..\installer\setup-dependencies.json" LogicalName="NexClip.Installer.Native.Resources.setup-dependencies.json" />
    <EmbeddedResource Include="Resources\payload.zip" Condition="Exists('Resources\payload.zip')" />
    <EmbeddedResource Include="Resources\app_icon.png" Condition="Exists('Resources\app_icon.png')" />
    <EmbeddedResource Include="Resources\app_icon.ico" Condition="Exists('Resources\app_icon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexClip.Installer.Native.Tests" />
  </ItemGroup>

</Project>
