<Window x:Class="NexClip.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexClip 安装向导"
        Width="540" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Loaded="Window_Loaded">

    <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义 Fluent 顶栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="{StaticResource LucideClipboard}"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="2"
                          Width="15" Height="15"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleTextBlock"
                               Text="NexClip 安装向导"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeButton_Click">
                        <Path Data="{StaticResource LucideMinus}"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              Width="10" Height="10"
                              Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseCaptionButtonStyle}" Click="CloseButton_Click">
                        <Path Data="{StaticResource LucideX}"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              Width="10" Height="10"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 主内容区域 (状态切换) -->
            <Grid Grid.Row="1" Margin="28,10,28,24">

                <!-- 1. 欢迎与安装选项面板 -->
                <Grid x:Name="WelcomePanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 品牌标头与版本 -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,16">
                        <Border Width="56" Height="56"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Path Data="{StaticResource LucideDownload}"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="NexClip"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="#26006EFF"
                                    BorderBrush="#55006EFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v20260825.02"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="现代化跨平台剪贴板同步与局域网流转工具"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 中间自定义区域 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- 折叠自定义安装卡片 -->
                        <Border x:Name="CustomInstallCard"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Visibility="Collapsed"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="安装路径:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallPathTextBox"
                                             Style="{StaticResource FluentTextBoxStyle}"
                                             Height="32" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Padding="12,6"
                                            Click="BrowseFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource LucideFolder}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="2"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="浏览" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="DesktopShortcutCheckBox"
                                              Content="创建桌面快捷方式"
                                              IsChecked="True"
                                              Style="{StaticResource FluentCheckBoxStyle}"
                                              Margin="0,0,16,0" />
                                    <CheckBox x:Name="StartupCheckBox"
                                              Content="开机自动启动"
                                              IsChecked="False"
                                              Style="{StaticResource FluentCheckBoxStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 底部操作按钮 -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="InstallButton"
                                    Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="38"
                                    Click="InstallButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource LucideDownload}"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="一键安装" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ToggleCustomButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Click="ToggleCustom_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="CustomToggleIcon"
                                          Data="{StaticResource LucideSettings}"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="CustomToggleText" Text="自定义" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="点击安装即表示您已阅读并同意最终用户许可协议与隐私说明"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 2. 解压与安装进度面板 -->
                <Grid x:Name="InstallingPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="440">
                        <Border Width="48" Height="48"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Data="{StaticResource LucideDownload}"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  Width="22" Height="22"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="正在安装 NexClip..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />

                        <TextBlock x:Name="InstallStatusTextBlock"
                                   Text="正在准备解压核心组件..."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                        <ProgressBar x:Name="InstallProgressBar"
                                     Style="{StaticResource FluentProgressBarStyle}"
                                     Value="0" Maximum="100" />

                        <TextBlock x:Name="InstallDetailTextBlock"
                                   Text="0%"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 3. 安装完成面板 -->
                <Grid x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="400">
                        <Border Width="56" Height="56"
                                Background="#2010B981"
                                BorderBrush="#4010B981"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <Path Data="{StaticResource LucideCheck}"
                                  Stroke="{StaticResource SuccessBrush}"
                                  StrokeThickness="2.4"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="安装完成！"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="NexClip 已成功部署至您的计算机，随时体验高效同步。"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Height="38"
                                    Click="LaunchButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource LucidePlay}"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="立即体验" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Padding="20,0"
                                    Content="完成"
                                    Click="CloseButton_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 4. 卸载向导面板 -->
                <Grid x:Name="UninstallPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="420">
                        <Border Width="56" Height="56"
                                Background="#20EF4444"
                                BorderBrush="#40EF4444"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <Path Data="{StaticResource LucideTrash2}"
                                  Stroke="{StaticResource DangerBrush}"
                                  StrokeThickness="2.2"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="卸载 NexClip"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="您确定要从当前计算机中卸载并清理 NexClip 吗？"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18" />

                        <CheckBox x:Name="KeepUserDataCheckBox"
                                  Content="保留用户本地配置与历史记录数据"
                                  IsChecked="True"
                                  Style="{StaticResource FluentCheckBoxStyle}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Height="38"
                                    Click="ConfirmUninstallButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource LucideTrash2}"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="确认卸载" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Padding="20,0"
                                    Content="取消"
                                    Click="CloseButton_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 5. 卸载完成面板 -->
                <Grid x:Name="UninstallCompletePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="380">
                        <Border Width="56" Height="56"
                                Background="#2010B981"
                                BorderBrush="#4010B981"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <Path Data="{StaticResource LucideCheck}"
                                  Stroke="{StaticResource SuccessBrush}"
                                  StrokeThickness="2.4"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="卸载完成"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="NexClip 已成功从您的计算机中完全移除。"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24" />

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                Content="关闭"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
