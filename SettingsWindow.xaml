<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SyncClipboard.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NexClip 设置">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ====== 自定义标题栏:汉堡 + 拖拽区 + 标题 + 窗口按钮 ====== -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 汉堡菜单:切换侧边栏(pane)开合 -->
            <Button
                Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Click="TogglePane_Click"
                ToolTipService.ToolTip="展开/收起侧边栏">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <!-- 可拖拽区(SetTitleBar) -->
            <Grid x:Name="TitleDragRegion" Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="ms-appx:///Assets/icon.png" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="NexClip" FontSize="12" FontWeight="SemiBold" IsHitTestVisible="False" VerticalAlignment="Center" />
                    <TextBlock Text="设置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <!-- 窗口操作按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Width="46"
                    Height="48"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="Minimize_Click"
                    ToolTipService.ToolTip="最小化">
                    <SymbolIcon Symbol="Remove" />
                </Button>
                <Button
                    Width="46"
                    Height="48"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="Close_Click"
                    ToolTipService.ToolTip="关闭">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ====== 设置内容 ====== -->
        <views:SettingsPage x:Name="SettingsHost" Grid.Row="1" xmlns:views="using:SyncClipboard.Desktop.Views" />
    </Grid>
</Window>
