<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NexClip.Desktop.Views.ClipboardMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NexClip.Desktop.Converters"
    xmlns:services="using:NexClip.Desktop.Services"
    xmlns:views="using:NexClip.Desktop.Views"
    xmlns:vm="using:NexClip.Desktop.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="Page_DragOver"
        DragLeave="Page_DragLeave"
        Drop="Page_Drop"
        PreviewKeyDown="OnPagePreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏容器: 顶部独立拖拽手柄热区 + 搜索框与操作按钮 -->
        <StackPanel x:Name="TopBar" Background="Transparent" Spacing="2">
            <!-- 1. 顶部手柄拖拽条 (大面积拖拽热区) -->
            <Grid x:Name="DragHandleBar" Height="16" Background="Transparent" VerticalAlignment="Top">
                <Border
                    Width="60"
                    Height="4"
                    CornerRadius="2"
                    Background="{ThemeResource TextFillColorTertiaryBrush}"
                    Opacity="0.85"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />
            </Grid>

            <!-- 2. 搜索框与操作按钮 -->
            <Grid Height="38" Padding="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 搜索框(内置一键清空按钮与快捷键提示) -->
                <Grid x:Name="SearchBoxHost" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="搜索历史 (Ctrl+F)"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        GotFocus="SearchBox_GotFocus"
                        LostFocus="SearchBox_LostFocus"
                        Padding="10,5,28,5"
                        Height="32"
                        VerticalAlignment="Center" />
                    <Button
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Padding="4"
                        Width="24"
                        Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        ToolTipService.ToolTip="清空搜索">
                        <Image x:Name="ClearSearchImage" Source="{x:Bind services:Lucide.X}" Width="12" Height="12" />
                    </Button>
                </Grid>
                <StackPanel x:Name="TopButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="ClearHistoryButton" Click="ClearHistoryButton_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="清空记录">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Button.Resources>
                        <Image x:Name="ClearHistoryButtonImage" Source="{x:Bind services:Lucide.Trash}" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="TopmostButton" Click="TopmostButton_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="置顶窗口">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Button.Resources>
                        <!-- 双图标叠放:切换时交叉淡化,避免 Image.Source 换源瞬间闪烁 -->
                        <Grid Width="16" Height="16">
                            <Image x:Name="TopmostIconPin" Source="{x:Bind services:Lucide.Pin}" Width="16" Height="16" />
                            <Image x:Name="TopmostIconPinOff" Source="{x:Bind services:Lucide.PinOffActive}" Width="16" Height="16" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button Click="SettingsButton_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="设置">
                        <Image x:Name="SettingsButtonImage" Source="{x:Bind services:Lucide.Settings}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 分类选择栏(WinUI 3 原生 SelectorBar 控件,自带平滑滑块与选中动效) -->
        <SelectorBar
            x:Name="CategorySelectorBar"
            Grid.Row="1"
            Margin="16,2,16,2"
            SelectionChanged="CategorySelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="TabAll" Text="全部" Tag="0" />
            <SelectorBarItem x:Name="TabText" Text="文本" Tag="1" />
            <SelectorBarItem x:Name="TabImage" Text="图片" Tag="2" />
            <SelectorBarItem x:Name="TabLink" Text="链接" Tag="4" />
            <SelectorBarItem x:Name="TabStar" Text="收藏" Tag="3" />
            <SelectorBarItem x:Name="TabTransfer" Text="即时互传" Tag="5" />
        </SelectorBar>

        <!-- 条目列表 -->
        <Grid x:Name="ListHost" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ListTranslateTransform" />
            </Grid.RenderTransform>
            <ListView
                x:Name="EntryList"
                ItemsSource="{Binding Items}"
                SelectionMode="Single"
                SelectionChanged="EntryList_SelectionChanged"
                KeyDown="EntryList_KeyDown"
                Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- 间距由卡片 Border 的 Margin 控制(ListViewItem Padding 对内容不生效) -->
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="MinHeight" Value="0" />
                        <!-- 条目获得键盘焦点时不显示 WinUI 默认黑色焦点框,避免覆盖卡片边缘。 -->
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <!-- 重写模板:禁用默认 PointerOver/Pressed/Selected 灰色遮罩,hover 效果由条目自身的线框呈现。
                             注意:只引用 WinUI 3 仍然存在的资源,避免 presenter 测量崩溃(E_FAIL)。 -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ListViewItemPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        SelectionCheckMarkVisualEnabled="False"
                                        PointerOverBackground="Transparent"
                                        PressedBackground="Transparent"
                                        SelectedBackground="Transparent"
                                        SelectedPointerOverBackground="Transparent"
                                        FocusVisualMargin="{TemplateBinding FocusVisualMargin}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="16,6"
                            PointerEntered="Item_PointerEntered"
                            PointerExited="Item_PointerExited"
                            DoubleTapped="Item_DoubleTapped"
                            RightTapped="Item_RightTapped"
                            ToolTipService.ToolTip="双击粘贴"
                            BorderThickness="{x:Bind BorderThicknessFor(IsSelected, IsHovered), Mode=OneWay}"
                            BorderBrush="{x:Bind BorderBrushFor(IsSelected, IsHovered), Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Border.ContextFlyout>
                                <MenuFlyout Opening="EntryMenu_Opening">
                                    <!-- 智能直达动态菜单项 (根据条目内容智能识别并呈现，保持条目卡片轻量不加多余徽标) -->
                                    <MenuFlyoutItem x:Name="SmartPrimaryMenuItem" Click="SmartPrimaryMenuItem_Click" Visibility="Collapsed">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.ExternalLink}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SmartSecondaryMenuItem" Click="SmartSecondaryMenuItem_Click" Visibility="Collapsed">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Copy}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="SmartActionSeparator" Visibility="Collapsed" />

                                    <MenuFlyoutItem Text="复制" Click="CopyMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Copy}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="PastePlainTextMenuItem" Text="纯文本粘贴 (Shift+Enter)" Click="PastePlainTextMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.FileText}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyPlainTextMenuItem" Text="复制为纯文本" Click="CopyPlainTextMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Copy}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="推送到所有设备" Click="PushToDevicesMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Upload}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="收藏" Click="StarMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Star}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="RemarkMenuItem" Text="添加/修改备注" Click="RemarkMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Edit}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="EditMenuItem" Text="编辑" Click="EditMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Edit}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="ViewImageMenuItem" Text="查看大图" Click="ViewImageMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.ZoomIn}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="OpenSystemViewerMenuItem" Text="用系统应用打开" Click="OpenSystemViewerMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.ExternalLink}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SaveImageMenuItem" Text="另存为..." Click="SaveImageMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Save}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="LocateFileMenuItem" Text="在文件夹中显示" Click="LocateFileMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.FolderOpen}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyAppNameMenuItem" Text="复制来源应用名称" Click="CopyAppNameMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Copy}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="删除" Click="DeleteMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon Source="{x:Bind services:Lucide.Trash}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="6">
                                <!-- 元信息行 + 操作按钮(hover/选中显示,位于条目右上角) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Image Source="{x:Bind TypeIconSource, Mode=OneWay}" Width="13" Height="13" />
                                        <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind RelativeTime, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                        <!-- 来源应用程序 (应用小图标 + 名称) -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind HasSourceApp, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            ToolTipService.ToolTip="{x:Bind SourceAppName, Mode=OneWay}">
                                            <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image
                                                Source="{x:Bind SourceAppIcon, Mode=OneWay}"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasSourceAppIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock
                                                Text="{x:Bind SourceAppName, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxWidth="72" />
                                        </StackPanel>

                                        <!-- 远端同步设备来源 -->
                                        <TextBlock
                                            Text="{x:Bind DeviceName}"
                                            FontSize="12"
                                            Foreground="#2563EB"
                                            TextTrimming="CharacterEllipsis"
                                            MaxWidth="96"
                                            Visibility="{x:Bind HasSourceApp, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        Opacity="{x:Bind ActionOpacityFor(IsHovered, IsSelected), Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind ActionHitTestFor(IsHovered, IsSelected), Mode=OneWay}">
                                        <Button Padding="6,3" Background="Transparent" BorderThickness="0" Command="{x:Bind CopyCommand}" ToolTipService.ToolTip="复制">
                                            <Image Source="{x:Bind services:Lucide.Copy}" Width="14" Height="14" />
                                        </Button>
                                        <Button Padding="6,3" Background="Transparent" BorderThickness="0" Command="{x:Bind ToggleStarCommand}" ToolTipService.ToolTip="收藏">
                                            <Image Source="{x:Bind StarSource, Mode=OneWay}" Width="14" Height="14" />
                                        </Button>
                                        <Button Padding="6,3" Background="Transparent" BorderThickness="0" Command="{x:Bind DeleteCommand}" ToolTipService.ToolTip="删除">
                                            <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- ====== 预览区域：自动按备注与原内容中较大高度排版，鼠标悬停时平滑无缝切换 ====== -->
                                <Grid>
                                    <!-- 备注信息 (左侧带备注小图标，有备注且未悬停时展示；不使用额外卡片包裹以防撑大间距) -->
                                    <Grid
                                        ColumnSpacing="6"
                                        VerticalAlignment="Top"
                                        ToolTipService.ToolTip="悬停查看原内容"
                                        Visibility="{x:Bind HasRemark, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Opacity="{x:Bind RemarkOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind RemarkHitTest, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Source="{x:Bind services:Lucide.Edit}"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Top"
                                            Margin="0,3,0,0" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Remark, Mode=OneWay}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxHeight="60"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Top" />
                                    </Grid>

                                    <!-- 原始内容预览层 (无备注或悬停时展示；未悬停且有备注时以 Opacity=0 占位测量确保卡片高度恒定) -->
                                    <Grid
                                        VerticalAlignment="Top"
                                        Opacity="{x:Bind OriginalOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind OriginalHitTest, Mode=OneWay}">
                                        <!-- 预览:图片 / 颜色色块 / 代码片段 / 普通文本 -->
                                        <Image
                                            Source="{x:Bind Thumbnail, Mode=OneTime}"
                                            MaxHeight="140"
                                            MaxWidth="360"
                                            HorizontalAlignment="Left"
                                            Tapped="ImageThumbnail_Tapped"
                                            DoubleTapped="ImageThumbnail_DoubleTapped"
                                            ToolTipService.ToolTip="单击预览大图，双击直接粘贴"
                                            Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <!-- 颜色代码与色块微预览 -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsColor, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <Border
                                                Width="16"
                                                Height="16"
                                                CornerRadius="4"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{x:Bind ColorBrush, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind PreviewText, Mode=OneWay}"
                                                FontFamily="Cascadia Code, Consolas"
                                                FontWeight="SemiBold"
                                                FontSize="14"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- 代码 / JSON 片段等宽排版与微底纹 -->
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Visibility="{x:Bind IsCodeOrJson, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                Text="{x:Bind PreviewText, Mode=OneWay}"
                                                FontFamily="Cascadia Code, Consolas"
                                                TextWrapping="Wrap"
                                                MaxHeight="80"
                                                TextTrimming="CharacterEllipsis"
                                                FontSize="13" />
                                        </Border>
                                        <!-- 普通文本预览 -->
                                        <TextBlock
                                            Text="{x:Bind PreviewText, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            MaxHeight="60"
                                            TextTrimming="CharacterEllipsis"
                                            FontSize="14"
                                            Visibility="{x:Bind IsNormalText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Grid>

                                <!-- 条目底部：智能直达快捷微胶囊操作栏 (有识别动作时展示) -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,2,0,0"
                                    Visibility="{x:Bind HasSmartAction, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <!-- 主动作胶囊按钮 -->
                                    <Button
                                        Padding="8,3"
                                        MinHeight="26"
                                        CornerRadius="13"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Command="{x:Bind SmartPrimaryCommand}"
                                        ToolTipService.ToolTip="{x:Bind SmartPrimaryToolTip, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Image Source="{x:Bind SmartPrimaryIcon, Mode=OneWay}" Width="12" Height="12" />
                                            <TextBlock Text="{x:Bind SmartPrimaryText, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 副动作胶囊按钮 (如复制 Git Clone、复制提取码、复制 HSL 等) -->
                                    <Button
                                        Padding="8,3"
                                        MinHeight="26"
                                        CornerRadius="13"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Visibility="{x:Bind HasSmartSecondary, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Command="{x:Bind SmartSecondaryCommand}"
                                        ToolTipService.ToolTip="{x:Bind SmartSecondaryToolTip, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Image Source="{x:Bind SmartSecondaryIcon, Mode=OneWay}" Width="12" Height="12" />
                                            <TextBlock Text="{x:Bind SmartSecondaryText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        Padding="0,10,0,16"
                        Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}">
                        <ProgressRing Width="14" Height="14" IsActive="True" />
                        <TextBlock Text="正在加载更多…" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListView.Footer>
            </ListView>

            <!-- 居中精美图形化空状态插画 -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <Border
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                    <Grid Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image
                            Source="{x:Bind services:Lucide.Clipboard}"
                            Width="28"
                            Height="28"
                            Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVis}}" />
                        <Image
                            Source="{x:Bind services:Lucide.Search}"
                            Width="28"
                            Height="28"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding EmptyTitle}"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding EmptySubtitle}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 回到顶部悬浮按钮:下滑超过阈值后,上滑时出现;点击回到列表顶部 -->
            <Button
                x:Name="BackToTopButton"
                AutomationProperties.AutomationId="BackToTopButton"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Padding="0"
                Click="BackToTopButton_Click"
                PointerExited="BackToTop_PointerExited"
                Visibility="Collapsed"
                ToolTipService.ToolTip="回到顶部"
                Background="#2563EB"
                BorderThickness="0"
                CornerRadius="18">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF" />
                </Button.Resources>
                <Image Source="{x:Bind services:Lucide.ArrowUp}" Width="16" Height="16" />
            </Button>
        </Grid>

        <!-- 即时互传聊天界面 -->
        <views:TransferChatPage
            x:Name="TransferChatHost"
            Grid.Row="2"
            Visibility="Collapsed"
            RenderTransformOrigin="0.5,0.5">
            <views:TransferChatPage.RenderTransform>
                <TranslateTransform x:Name="ChatTranslateTransform" />
            </views:TransferChatPage.RenderTransform>
        </views:TransferChatPage>

        <!-- 全屏大图查看器浮层 (Lightbox ImageViewer) -->
        <Grid
            x:Name="ImageViewerOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="100"
            Visibility="Collapsed"
            Background="#E6050B14"
            KeyDown="ImageViewer_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏 HUD (图片文件名/信息 + 关闭按钮) -->
            <Grid Padding="16,10" Background="#40000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="{x:Bind services:Lucide.ImageMuted}" Width="15" Height="15" />
                    <TextBlock x:Name="ViewerInfoText" Text="图片预览" FontSize="13" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Click="CloseViewer_Click"
                    Padding="8,6"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    ToolTipService.ToolTip="关闭 (Esc)">
                    <Image Source="{x:Bind services:Lucide.XWhite}" Width="15" Height="15" />
                </Button>
            </Grid>

            <!-- 中间主视图 (图片画布, 支持 GPU 变换滚轮缩放与鼠标拖拽平移) -->
            <Grid
                x:Name="ViewerCanvas"
                Grid.Row="1"
                Background="Transparent"
                SizeChanged="ViewerCanvas_SizeChanged"
                PointerWheelChanged="ViewerCanvas_PointerWheelChanged"
                PointerPressed="ViewerCanvas_PointerPressed"
                PointerMoved="ViewerCanvas_PointerMoved"
                PointerReleased="ViewerCanvas_PointerReleased"
                PointerCanceled="ViewerCanvas_PointerReleased"
                DoubleTapped="ViewerCanvas_DoubleTapped">
                <Grid x:Name="ViewerImageContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image
                        x:Name="ViewerImage"
                        Stretch="Uniform"
                        RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ViewerRotateTransform" Angle="0" />
                                <ScaleTransform x:Name="ViewerScaleTransform" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ViewerTranslateTransform" X="0" Y="0" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>

            <!-- 底部浮动操作工具栏 (HUD Pill Bar) -->
            <Border
                Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                CornerRadius="20"
                Background="#D91E293B"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="ZoomOut_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="缩小 (-)">
                        <Image Source="{x:Bind services:Lucide.ZoomOutWhite}" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="ViewerZoomText" Text="100%" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Width="44" TextAlignment="Center" />
                    <Button Click="ZoomIn_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="放大 (+)">
                        <Image Source="{x:Bind services:Lucide.ZoomInWhite}" Width="15" Height="15" />
                    </Button>
                    <Button Click="ZoomReset_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="适应窗口 / 1:1">
                        <Image Source="{x:Bind services:Lucide.Maximize2White}" Width="15" Height="15" />
                    </Button>
                    <Rectangle Width="1" Height="16" Fill="#475569" Margin="4,0" />
                    <Button Click="Rotate_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="旋转 90°">
                        <Image Source="{x:Bind services:Lucide.RotateCwWhite}" Width="15" Height="15" />
                    </Button>
                    <Button Click="CopyViewerImage_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="复制图片 (Ctrl+C)">
                        <Image Source="{x:Bind services:Lucide.CopyWhite}" Width="15" Height="15" />
                    </Button>
                    <Button Click="SaveViewerImage_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="另存为 (Ctrl+S)">
                        <Image Source="{x:Bind services:Lucide.SaveWhite}" Width="15" Height="15" />
                    </Button>
                    <Button Click="OpenInSystemApp_Click" Padding="8,6" Background="Transparent" BorderThickness="0" CornerRadius="14" ToolTipService.ToolTip="用系统看图软件打开">
                        <Image Source="{x:Bind services:Lucide.ExternalLinkWhite}" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 全窗口拖拽发送覆盖层 (Drag & Drop Overlay) -->
        <Grid
            x:Name="DragDropOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="95"
            Visibility="Collapsed"
            Opacity="0"
            Background="#D90F172A"
            IsHitTestVisible="False">
            <Border
                Margin="20"
                CornerRadius="16"
                BorderBrush="#3B82F6"
                BorderThickness="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Border
                        Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="#1A3B82F6"
                        HorizontalAlignment="Center">
                        <Image
                            Source="{x:Bind services:Lucide.Upload}"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock
                            Text="松开即可发送至已同步设备"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="支持将图片、文件与文本直接拖拽上传"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
