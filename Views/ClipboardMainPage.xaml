<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncClipboard.Desktop.Views.ClipboardMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SyncClipboard.Desktop.Converters"
    xmlns:services="using:SyncClipboard.Desktop.Services"
    xmlns:vm="using:SyncClipboard.Desktop.ViewModels">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏:拖拽区 + 状态 + 操作 -->
        <Grid x:Name="TopBar" Height="44" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#10B981" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="14" Height="14" />
            </StackPanel>
            <StackPanel x:Name="TopButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding SyncCurrentClipboardCommand}" Padding="8,6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="同步当前剪贴板">
                    <Image Source="{x:Bind services:Lucide.RefreshCw}" Width="16" Height="16" />
                </Button>
                <Button Click="SettingsButton_Click" Padding="8,6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="设置">
                    <Image Source="{x:Bind services:Lucide.Settings}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Padding="16,4,16,0">
            <TextBox
                PlaceholderText="搜索剪贴板历史"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 分类标签(自定义胶囊,适配窄窗口) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="16,8,16,2">
            <Border x:Name="TabAll" CornerRadius="4" Padding="10,3" Tapped="FilterTapped" Tag="0" Background="#2563EB">
                <TextBlock x:Name="TabAllText" Text="全部" FontSize="13" Foreground="White" />
            </Border>
            <Border x:Name="TabText" CornerRadius="4" Padding="10,3" Tapped="FilterTapped" Tag="1" Background="Transparent">
                <TextBlock x:Name="TabTextText" Text="文本" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
            <Border x:Name="TabImage" CornerRadius="4" Padding="10,3" Tapped="FilterTapped" Tag="2" Background="Transparent">
                <TextBlock x:Name="TabImageText" Text="图片" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
            <Border x:Name="TabStar" CornerRadius="4" Padding="10,3" Tapped="FilterTapped" Tag="3" Background="Transparent">
                <TextBlock x:Name="TabStarText" Text="收藏" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
        </StackPanel>

        <!-- 条目列表 -->
        <Grid x:Name="ListHost" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="EntryList"
                ItemsSource="{Binding Items}"
                SelectionMode="Single"
                SelectionChanged="EntryList_SelectionChanged"
                Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- 间距由卡片 Border 的 Margin 控制(ListViewItem Padding 对内容不生效) -->
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="MinHeight" Value="0" />
                        <!-- 重写模板:禁用默认 PointerOver/Pressed/Selected 灰色遮罩,hover 效果由条目自身的线框呈现。
                             注意:只引用 WinUI 3 仍然存在的资源,避免 presenter 测量崩溃(E_FAIL)。 -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ListViewItemPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        SelectionCheckMarkVisualEnabled="False"
                                        PointerOverBackground="Transparent"
                                        PressedBackground="Transparent"
                                        SelectedBackground="Transparent"
                                        SelectedPointerOverBackground="Transparent"
                                        FocusVisualMargin="{TemplateBinding FocusVisualMargin}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="24,12"
                            PointerEntered="Item_PointerEntered"
                            PointerExited="Item_PointerExited"
                            BorderThickness="{x:Bind BorderThicknessFor(IsSelected, IsHovered), Mode=OneWay}"
                            BorderBrush="{x:Bind BorderBrushFor(IsSelected, IsHovered), Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <!-- 元信息行 + 操作按钮(hover/选中显示,位于条目右上角) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Image Source="{x:Bind TypeIconSource, Mode=OneWay}" Width="13" Height="13" />
                                        <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind RelativeTime, Mode=OneTime}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind DeviceName}" FontSize="12" Foreground="#2563EB" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        Opacity="{x:Bind ActionOpacityFor(IsHovered, IsSelected), Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind ActionHitTestFor(IsHovered, IsSelected), Mode=OneWay}">
                                        <Button Padding="6,3" Background="Transparent" BorderThickness="0" Command="{x:Bind CopyCommand}" ToolTipService.ToolTip="复制">
                                            <Image Source="{x:Bind services:Lucide.Copy}" Width="14" Height="14" />
                                        </Button>
                                        <Button Padding="6,3" Background="Transparent" BorderThickness="0" Command="{x:Bind ToggleStarCommand}" ToolTipService.ToolTip="收藏">
                                            <Image Source="{x:Bind StarSource, Mode=OneWay}" Width="14" Height="14" />
                                        </Button>
                                        <Button Padding="6,3" Background="Transparent" BorderThickness="0" Command="{x:Bind DeleteCommand}" ToolTipService.ToolTip="删除">
                                            <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- 预览 -->
                                <Image Source="{x:Bind Thumbnail, Mode=OneTime}" MaxHeight="140" HorizontalAlignment="Left" Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock
                                    Text="{x:Bind PreviewText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    MaxHeight="60"
                                    TextTrimming="CharacterEllipsis"
                                    FontSize="14"
                                    Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- 空态(无提示文本时整行隐藏,不占底部空间) -->
            <TextBlock
                Grid.Row="1"
                Text="{Binding EmptyHint}"
                Visibility="{Binding EmptyHintVisibility}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center"
                Margin="0,12,0,8" />
        </Grid>
    </Grid>
</Page>
