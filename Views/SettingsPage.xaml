<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncClipboard.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SyncClipboard.Desktop.Converters"
    xmlns:models="using:SyncClipboard.Desktop.Models"
    x:Name="SettingsRoot">
    <Page.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrush" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="16">

            <!-- ========== 服务端连接 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="服务端连接" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBlock Text="服务器地址" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        PlaceholderText="http://127.0.0.1:5033"
                        Text="{Binding ServerUrl, Mode=TwoWay}" />

                    <TextBlock Text="访问令牌" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <PasswordBox x:Name="TokenBox" PlaceholderText="与各端共享的访问令牌" />

                    <TextBlock Text="设备名称" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        PlaceholderText="默认使用计算机名"
                        Text="{Binding DeviceName, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="测试连接" Command="{Binding TestConnectionCommand}" />
                        <ProgressRing IsActive="{Binding IsTesting}" Width="16" Height="16" />
                    </StackPanel>
                    <TextBlock Text="{Binding TestResult}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <Button Content="保存设置" Command="{Binding SaveServerConfigCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ========== 设备列表 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备列表" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DeviceStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Content="刷新" Command="{Binding RefreshDevicesCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceInfo">
                                <Grid Margin="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 在线状态点 -->
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                        Fill="{x:Bind Online, Mode=OneWay, Converter={StaticResource BoolToBrush}}" />
                                    <!-- 设备信息 -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind LastSeenText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <!-- 操作 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button
                                            Content="重命名"
                                            Padding="8,4"
                                            FontSize="12"
                                            Command="{Binding ElementName=SettingsRoot, Path=DataContext.StartRenameCommand}"
                                            CommandParameter="{x:Bind}" />
                                        <Button
                                            Content="移除"
                                            Padding="8,4"
                                            FontSize="12"
                                            Command="{Binding ElementName=SettingsRoot, Path=DataContext.RemoveDeviceCommand}"
                                            CommandParameter="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 行内重命名编辑 -->
                    <Grid Visibility="{Binding RenamingDeviceId, Converter={StaticResource NullToVisibility}}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="输入新设备名称" />
                        <Button Grid.Column="1" Content="确定" Command="{Binding ConfirmRenameCommand}" />
                        <Button Grid.Column="2" Content="取消" Command="{Binding CancelRenameCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 行为 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="行为" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                    <ToggleSwitch Header="开机自启动(静默运行)" OnContent="" OffContent="" IsOn="{Binding BootStartEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="启动时最小化到托盘" OnContent="" OffContent="" IsOn="{Binding StartMinimized, Mode=TwoWay}" />
                    <ToggleSwitch Header="关闭窗口时最小化到托盘" OnContent="" OffContent="" IsOn="{Binding CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="监听剪贴板(同步开关)" OnContent="" OffContent="" IsOn="{Binding MonitorEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="接收推送自动写入剪贴板" OnContent="" OffContent="" IsOn="{Binding AutoPaste, Mode=TwoWay}" />
                    <ToggleSwitch Header="新内容通知" OnContent="" OffContent="" IsOn="{Binding NotifyEnabled, Mode=TwoWay}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="剪贴板热键(呼出剪贴板窗口)" />
                            <TextBlock Text="点击输入框后直接按下组合键" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="HotKeyBox" Width="150" IsReadOnly="True"
                                PlaceholderText="点击后按组合键"
                                Text="{Binding Hotkey, Mode=OneWay}"
                                PreviewKeyDown="HotKeyBox_PreviewKeyDown" HorizontalAlignment="Right" />
                            <Button Content="重置" Command="{Binding ResetHotkeyCommand}" ToolTipService.ToolTip="恢复默认 Alt+V" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="设置热键(打开设置窗口)" />
                            <TextBlock Text="点击输入框后直接按下组合键" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="HotKeySettingsBox" Width="150" IsReadOnly="True"
                                PlaceholderText="点击后按组合键"
                                Text="{Binding HotkeySettings, Mode=OneWay}"
                                PreviewKeyDown="HotKeySettingsBox_PreviewKeyDown" HorizontalAlignment="Right" />
                            <Button Content="重置" Command="{Binding ResetHotkeySettingsCommand}" ToolTipService.ToolTip="恢复默认 Alt+X" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 历史 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="历史" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="本地历史上限" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                Width="200"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding MaxHistoryOptions}"
                                SelectedIndex="{Binding MaxHistoryIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Content="清空历史" Command="{Binding ClearHistoryCommand}" />
                            <TextBlock Text="同时删除本地图片缓存" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 外观 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                    <RadioButtons Header="界面主题" SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                        <RadioButton Content="浅色" />
                        <RadioButton Content="深色" />
                        <RadioButton Content="跟随系统" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- ========== 关于 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="SyncClipboard 桌面端" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border Background="#2563EB33" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="WinUI 3(.NET 9)剪贴板同步客户端 · 对接 SyncClipboard Server(设计文档: syncclipboard-server/CLIENT-DESIGN.md)"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
