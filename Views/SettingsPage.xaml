<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NexClip.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NexClip.Desktop.Converters"
    xmlns:models="using:NexClip.Desktop.Models"
    xmlns:services="using:NexClip.Desktop.Services"
    xmlns:vm="using:NexClip.Desktop.ViewModels"
    x:Name="SettingsRoot">
    <Page.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrush" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:PercentConverter x:Key="Percent" />
    </Page.Resources>
    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Auto"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        OpenPaneLength="200"
        CompactPaneLength="48"
        CompactModeThresholdWidth="480"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="同步" Tag="server">
                <NavigationViewItem.Icon><ImageIcon Source="{x:Bind services:Lucide.Server}" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="通用" Tag="general">
                <NavigationViewItem.Icon><ImageIcon Source="{x:Bind services:Lucide.Settings}" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="剪贴板" Tag="clipboard">
                <NavigationViewItem.Icon><ImageIcon Source="{x:Bind services:Lucide.Clipboard}" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="快捷键" Tag="hotkey">
                <NavigationViewItem.Icon><ImageIcon Source="{x:Bind services:Lucide.Keyboard}" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="数据管理" Tag="data">
                <NavigationViewItem.Icon><ImageIcon Source="{x:Bind services:Lucide.Database}" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon><ImageIcon Source="{x:Bind services:Lucide.Info}" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <!-- ========== 内容区 ========== -->
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="560" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SettingsContentPanel.Padding" Value="14,16,14,24" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <ScrollViewer
                x:Name="ContentScroller"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <StackPanel x:Name="SettingsContentPanel" Padding="28,24,28,32" Spacing="20">

                    <!-- ====== 同步:服务端连接 + 设备列表 ====== -->
                    <StackPanel x:Name="GroupServer" Spacing="20">
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="服务器连接" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="服务器地址" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="http://127.0.0.1:5033"
                                        Text="{Binding ServerUrl, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding SaveServerConfigCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="14,6"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="保存设置" VerticalAlignment="Center" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding TestConnectionCommand}"
                                        Padding="14,6"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ProgressRing
                                                IsActive="{Binding IsTesting}"
                                                Width="14"
                                                Height="14"
                                                Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
                                            <Image
                                                Source="{x:Bind services:Lucide.RefreshCw}"
                                                Width="14"
                                                Height="14"
                                                Visibility="{Binding IsTesting, Converter={StaticResource InverseBoolToVis}}" />
                                            <TextBlock Text="测试连接" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="添加设备" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="14">
                                <!-- ① 生成配对码(给另一台设备,弹对话框显示码) -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button
                                        Content="生成配对码"
                                        Command="{Binding GeneratePairingCodeCommand}"
                                        HorizontalAlignment="Left" />
                                    <ProgressRing IsActive="{Binding IsGeneratingCode}" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="在另一台设备上输入此码即可接入" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- ② 输入 6 位配对验证码 (本机单向即入) -->
                                <TextBlock Text="加入现有设备组 (输入其他设备屏幕显示的 6 位纯数字验证码)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="输入 6 位配对验证码 (例如: 839201)"
                                        MaxLength="6"
                                        Text="{Binding PairingCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding PairDeviceCommand}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ProgressRing
                                                IsActive="{Binding IsPairing}"
                                                Width="14"
                                                Height="14"
                                                Visibility="{Binding IsPairing, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="立即连接" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="设备名称" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="默认使用计算机名"
                                        Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="保存名称"
                                        Command="{Binding SaveDeviceNameCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 设备列表分组标题栏 (标题在左, 设备数量与刷新按钮在右同一行) -->
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已连接设备" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding DeviceStatus}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Command="{Binding RefreshDevicesCommand}"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="{x:Bind services:Lucide.RotateCw}" Width="12" Height="12" VerticalAlignment="Center" />
                                        <TextBlock Text="刷新" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <ProgressBar
                                    Height="3"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsDevicesLoading, Converter={StaticResource BoolToVis}}" />

                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="#FDBA74"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    Visibility="{Binding HasDeviceLoadError, Converter={StaticResource BoolToVis}}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="30"
                                            Height="30"
                                            Background="#FFF7ED"
                                            BorderBrush="#FDBA74"
                                            BorderThickness="1"
                                            CornerRadius="15"
                                            VerticalAlignment="Top">
                                            <Image
                                                Source="{x:Bind services:Lucide.Info}"
                                                Width="16"
                                                Height="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="设备列表加载失败" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="设备列表暂时不可用" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock
                                                Text="{Binding DeviceLoadErrorText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Content="重新加载"
                                                Command="{Binding RefreshDevicesCommand}"
                                                HorizontalAlignment="Left"
                                                Padding="10,4"
                                                Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,18"
                                    Visibility="{Binding ShowDeviceEmptyState, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="{x:Bind services:Lucide.MonitorSmartphone}" Width="28" Height="28" HorizontalAlignment="Center" />
                                        <TextBlock Text="还没有其他设备" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="生成配对码邀请设备，或输入其他设备的配对码。"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            HorizontalTextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl
                                    ItemsSource="{Binding Devices}"
                                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DeviceInfo">
                                            <Border
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,3">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 左侧设备平台图标 -->
                                                    <Border
                                                        Width="36"
                                                        Height="36"
                                                        Background="{x:Bind vm:SettingsViewModel.DeviceIconBgBrush(Online), Mode=OneWay}"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Center">
                                                        <Image
                                                            Source="{x:Bind vm:SettingsViewModel.DevicePlatformIcon(Platform), Mode=OneWay}"
                                                            Width="18"
                                                            Height="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- 中间主体信息: 双行紧凑排版 -->
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <!-- 第一行: 设备名称 + [本机] 徽章 + [在线/离线] 状态胶囊 -->
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                FontSize="13.5"
                                                                VerticalAlignment="Center"
                                                                Foreground="{x:Bind vm:SettingsViewModel.DeviceNameBrush(Online), Mode=OneWay}" />

                                                            <Border
                                                                Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                Background="#2563EB"
                                                                CornerRadius="4"
                                                                Padding="5,1"
                                                                VerticalAlignment="Center">
                                                                <TextBlock Text="本机" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                                            </Border>

                                                            <!-- 在线 / 离线时间 状态胶囊徽章 -->
                                                            <Border
                                                                Background="{x:Bind vm:SettingsViewModel.DeviceStatusBgBrush(Online), Mode=OneWay}"
                                                                BorderBrush="{x:Bind vm:SettingsViewModel.DeviceStatusBorderBrush(Online), Mode=OneWay}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="6,1.5"
                                                                VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Ellipse
                                                                        Width="6"
                                                                        Height="6"
                                                                        Fill="{x:Bind vm:SettingsViewModel.DeviceStatusBrush(Online), Mode=OneWay}"
                                                                        VerticalAlignment="Center" />
                                                                    <TextBlock
                                                                        Text="{x:Bind LastSeenText}"
                                                                        FontSize="10.5"
                                                                        FontWeight="Medium"
                                                                        Foreground="{x:Bind vm:SettingsViewModel.DeviceStatusBrush(Online), Mode=OneWay}"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 第二行: 平台 · 版本 · IP 与 ID -->
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Subtitle}"
                                                                FontSize="11.5"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Text="{x:Bind Id}"
                                                                FontSize="10.5"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 右侧非本机展示移除按钮 -->
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="RemoveDevice_Click"
                                                        Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                                        Padding="6"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="6"
                                                        ToolTipService.ToolTip="移除此设备"
                                                        VerticalAlignment="Center">
                                                        <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== 常规:应用行为 ====== -->
                    <StackPanel x:Name="GroupGeneral" Visibility="Collapsed" Spacing="20">
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="启动与后台" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开机自启动(静默运行)" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding BootStartEnabled, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="开机自启动(静默运行)" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动时最小化到托盘" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding StartMinimized, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="启动时最小化到托盘" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="关闭窗口时最小化到托盘" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding CloseToTray, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="关闭窗口时最小化到托盘" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="启动时自动检查更新" VerticalAlignment="Center" />
                                        <TextBlock Text="应用启动后在后台自动检测是否有新版本发布" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding AutoCheckUpdate, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="启动时自动检查更新" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="更新下载来源" VerticalAlignment="Center" />
                                        <TextBlock Text="选择检查与下载新版本的通道 (国内网络推荐直连加速)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="180"
                                        SelectedIndex="{Binding UpdateSourceIndex, Mode=TwoWay}"
                                        ItemsSource="{Binding UpdateSourceOptions}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="更新下载来源" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="界面主题" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="160"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="浅色" />
                                        <ComboBoxItem Content="深色" />
                                        <ComboBoxItem Content="跟随系统" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="窗口背景" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="160"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectedIndex="{Binding BackdropIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="云母" />
                                        <ComboBoxItem Content="云母增强" />
                                        <ComboBoxItem Content="亚克力" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="亚克力不透明度" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider
                                            Width="140"
                                            Minimum="0.5"
                                            Maximum="1"
                                            StepFrequency="0.05"
                                            Value="{Binding BackdropTintOpacity, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="44"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Text="{Binding BackdropTintOpacity, Converter={StaticResource Percent}, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== 剪贴板:监听/粘贴/窗口 ====== -->
                    <StackPanel x:Name="GroupClipboard" Visibility="Collapsed" Spacing="20">
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="剪贴板行为" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="监听剪贴板(同步开关)" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding MonitorEnabled, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="监听剪贴板(同步开关)" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="接收推送自动写入剪贴板" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding AutoPaste, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
