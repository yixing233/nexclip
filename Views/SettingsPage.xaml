                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="富文本支持" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="新内容通知" VerticalAlignment="Center" />
                                        <TextBlock Text="接收到多端设备同步的新剪贴板时在右下角弹出浮窗提示" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding NotifyEnabled, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="新内容通知" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="剪贴板窗口出现位置" VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="160"
                                        HorizontalAlignment="Right"
                                        SelectedIndex="{Binding WindowPositionIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="跟随鼠标" />
                                        <ComboBoxItem Content="屏幕中心" />
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="普通应用粘贴键" />
                                        <TextBlock Text="Chromium/Electron 编辑器自动使用 Ctrl+V" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="160"
                                        HorizontalAlignment="Right"
                                        SelectedIndex="{Binding PasteKeyIndex, Mode=TwoWay}">
