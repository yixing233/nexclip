<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SyncClipboard.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="16">

            <!-- ========== 服务端连接 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="服务端连接" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBlock Text="服务器地址" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        PlaceholderText="http://127.0.0.1:5033"
                        Text="{Binding ServerUrl, Mode=TwoWay}" />

                    <TextBlock Text="访问令牌" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <PasswordBox x:Name="TokenBox" PlaceholderText="与各端共享的访问令牌" />

                    <TextBlock Text="设备名称" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        PlaceholderText="默认使用计算机名"
                        Text="{Binding DeviceName, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="测试连接" Command="{Binding TestConnectionCommand}" />
                        <ProgressRing IsActive="{Binding IsTesting}" Width="16" Height="16" />
                    </StackPanel>
                    <TextBlock Text="{Binding TestResult}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <Button Content="保存设置" Command="{Binding SaveServerConfigCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ========== 行为 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="行为" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                    <ToggleSwitch Header="开机自启" OnContent="" OffContent="" IsOn="{Binding BootStartEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="启动时最小化到托盘" OnContent="" OffContent="" IsOn="{Binding StartMinimized, Mode=TwoWay}" />
                    <ToggleSwitch Header="关闭窗口时最小化到托盘" OnContent="" OffContent="" IsOn="{Binding CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="监听剪贴板(同步开关)" OnContent="" OffContent="" IsOn="{Binding MonitorEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="接收推送自动写入剪贴板" OnContent="" OffContent="" IsOn="{Binding AutoPaste, Mode=TwoWay}" />
                    <ToggleSwitch Header="新内容通知" OnContent="" OffContent="" IsOn="{Binding NotifyEnabled, Mode=TwoWay}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="剪贴板热键(呼出剪贴板窗口)" />
                            <TextBlock Text="点击输入框后直接按下组合键" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="HotKeyBox" Width="150" IsReadOnly="True"
                                PlaceholderText="点击后按组合键"
                                Text="{Binding Hotkey, Mode=OneWay}"
                                PreviewKeyDown="HotKeyBox_PreviewKeyDown" HorizontalAlignment="Right" />
                            <Button Content="重置" Command="{Binding ResetHotkeyCommand}" ToolTipService.ToolTip="恢复默认 Alt+V" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="设置热键(打开设置窗口)" />
                            <TextBlock Text="点击输入框后直接按下组合键" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="HotKeySettingsBox" Width="150" IsReadOnly="True"
                                PlaceholderText="点击后按组合键"
                                Text="{Binding HotkeySettings, Mode=OneWay}"
                                PreviewKeyDown="HotKeySettingsBox_PreviewKeyDown" HorizontalAlignment="Right" />
                            <Button Content="重置" Command="{Binding ResetHotkeySettingsCommand}" ToolTipService.ToolTip="恢复默认 Alt+X" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 历史 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="历史" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="本地历史上限" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                Width="200"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding MaxHistoryOptions}"
                                SelectedIndex="{Binding MaxHistoryIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Content="清空历史" Command="{Binding ClearHistoryCommand}" />
                            <TextBlock Text="同时删除本地图片缓存" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== 外观 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
                    <RadioButtons Header="界面主题" SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                        <RadioButton Content="浅色" />
                        <RadioButton Content="深色" />
                        <RadioButton Content="跟随系统" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- ========== 关于 ========== -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="SyncClipboard 桌面端" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border Background="#2563EB33" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Text="WinUI 3(.NET 9)剪贴板同步客户端 · 对接 SyncClipboard Server(设计文档: syncclipboard-server/CLIENT-DESIGN.md)"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
