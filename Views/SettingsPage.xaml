                                        <ComboBoxItem Content="Ctrl+V" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ====== 复制直达与智能识别 ====== -->
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="复制直达与智能识别" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <!-- 总开关: 复制直达智能浮窗 -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="复制直达智能浮窗 (总开关)" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        IsOn="{Binding CopyDirectEnabled, Mode=TwoWay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="复制直达智能浮窗" />
                                </Grid>

                                <MenuFlyoutSeparator Visibility="{Binding CopyDirectEnabled, Converter={StaticResource BoolToVis}}" />

                                <!-- 细分能力配置项 (总开关关闭时自动收起) -->
                                <StackPanel Spacing="14" Visibility="{Binding CopyDirectEnabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="智能直达浮窗分类控制" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                    <!-- 1. 色彩识别 -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{x:Bind services:Lucide.Palette}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="颜色代码微预览与直达浮窗" />
                                            <TextBlock Text="识别 #RGB/HEX、rgb()、hsl() 色值，支持一键互转复制" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            Width="48"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{Binding SmartColorEnabled, Mode=TwoWay}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="颜色代码微预览与格式转换" />
                                    </Grid>

                                    <!-- 2. 本地文件与路径 -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{x:Bind services:Lucide.FolderOpen}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="本地文件 / 路径直达" />
                                            <TextBlock Text="识别 Windows 路径与文件，支持一键在资源管理器中定位或终端运行" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            Width="48"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{Binding SmartPathEnabled, Mode=TwoWay}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="本地文件与路径直达" />
                                    </Grid>

                                    <!-- 3. GitHub 深度识别 -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{x:Bind services:Lucide.ExternalLink}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="GitHub 仓库深度识别" />
                                            <TextBlock Text="识别 github.com 仓库链接，提供一键直达仓库与 git clone 命令复制" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            Width="48"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{Binding SmartDeepLinkEnabled, Mode=TwoWay}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="GitHub 仓库深度识别" />
                                    </Grid>

                                    <!-- 4. 网盘与提取码 -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{x:Bind services:Lucide.Download}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="网盘链接与提取码识别" />
                                            <TextBlock Text="覆盖百度/阿里/夸克/123/蓝奏等，自动抽离提取码并在打开网盘时自动复制" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            Width="48"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{Binding SmartNetDiskEnabled, Mode=TwoWay}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="网盘链接与提取码识别" />
                                    </Grid>

                                    <!-- 5. 通用网址 -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{x:Bind services:Lucide.ExternalLink}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="通用网页链接直达" />
                                            <TextBlock Text="识别 http/https 网址，一键在默认浏览器中打开" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            Width="48"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            IsOn="{Binding SmartUrlEnabled, Mode=TwoWay}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="通用网页链接直达" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== 快捷键:呼出热键 + 剪贴板窗口快捷操作说明 ====== -->
                    <StackPanel x:Name="GroupHotkey" Visibility="Collapsed" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="全局快捷键" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Border
                                Padding="4"
                                CornerRadius="12"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="点击输入框后直接按下组合键即可设置快捷键">
                                <Image
                                    Source="{x:Bind services:Lucide.Info}"
                                    Width="14"
                                    Height="14"
                                    Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="剪贴板热键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="呼出 / 隐藏剪贴板窗口" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBox x:Name="HotKeyBox" Width="140" IsReadOnly="True"
                                            PlaceholderText="点击后按组合键"
                                            Text="{Binding Hotkey, Mode=OneWay}"
                                            GotFocus="HotKeyBox_GotFocus"
                                            LostFocus="HotKeyBox_LostFocus"
                                            PreviewKeyDown="HotKeyBox_PreviewKeyDown" HorizontalAlignment="Right" />
                                        <Button Command="{Binding ClearHotkeyCommand}" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="清空热键">
                                            <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                        </Button>
                                        <Button Content="重置" Command="{Binding ResetHotkeyCommand}" ToolTipService.ToolTip="恢复默认 Alt+V" />
                                    </StackPanel>
                                </Grid>
                                <!-- 长久态错误(热键被占用):常驻显示,不自动消失 -->
                                <TextBlock
                                    Text="{Binding HotkeyStatusText}"
                                    FontSize="12"
                                    Foreground="#DC2626"
                                    Visibility="{Binding HasHotkeyIssue, Converter={StaticResource BoolToVis}}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="设置热键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="打开 NexClip 设置窗口" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBox x:Name="HotKeySettingsBox" Width="140" IsReadOnly="True"
                                            PlaceholderText="点击后按组合键"
                                            Text="{Binding HotkeySettings, Mode=OneWay}"
                                            GotFocus="HotKeyBox_GotFocus"
                                            LostFocus="HotKeyBox_LostFocus"
                                            PreviewKeyDown="HotKeySettingsBox_PreviewKeyDown" HorizontalAlignment="Right" />
                                        <Button Command="{Binding ClearHotkeySettingsCommand}" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="清空热键">
                                            <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                        </Button>
                                        <Button Content="重置" Command="{Binding ResetHotkeySettingsCommand}" ToolTipService.ToolTip="恢复默认 Alt+X" />
                                    </StackPanel>
                                </Grid>
                                <!-- 长久态错误(热键被占用):常驻显示,不自动消失 -->
                                <TextBlock
                                    Text="{Binding HotkeySettingsStatusText}"
                                    FontSize="12"
                                    Foreground="#DC2626"
                                    Visibility="{Binding HasHotkeySettingsIssue, Converter={StaticResource BoolToVis}}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="打开链接热键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="在浏览器中打开最近复制的网址" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBox x:Name="HotKeyOpenUrlBox" Width="140" IsReadOnly="True"
                                            PlaceholderText="点击后按组合键"
                                            Text="{Binding HotkeyOpenUrl, Mode=OneWay}"
                                            GotFocus="HotKeyBox_GotFocus"
                                            LostFocus="HotKeyBox_LostFocus"
                                            PreviewKeyDown="HotKeyOpenUrlBox_PreviewKeyDown" HorizontalAlignment="Right" />
                                        <Button Command="{Binding ClearHotkeyOpenUrlCommand}" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="清空热键">
                                            <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                        </Button>
                                        <Button Content="重置" Command="{Binding ResetHotkeyOpenUrlCommand}" ToolTipService.ToolTip="恢复默认 Ctrl+Alt+O" />
                                    </StackPanel>
                                </Grid>
                                <!-- 长久态错误(热键被占用):常驻显示,不自动消失 -->
                                <TextBlock
                                    Text="{Binding HotkeyOpenUrlStatusText}"
                                    FontSize="12"
                                    Foreground="#DC2626"
                                    Visibility="{Binding HasHotkeyOpenUrlIssue, Converter={StaticResource BoolToVis}}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="置顶热键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="切换剪贴板窗口始终在最前" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBox x:Name="HotKeyTopmostBox" Width="140" IsReadOnly="True"
                                            PlaceholderText="点击后按组合键"
                                            Text="{Binding HotkeyTopmost, Mode=OneWay}"
                                            GotFocus="HotKeyBox_GotFocus"
                                            LostFocus="HotKeyBox_LostFocus"
                                            PreviewKeyDown="HotKeyTopmostBox_PreviewKeyDown" HorizontalAlignment="Right" />
                                        <Button Command="{Binding ClearHotkeyTopmostCommand}" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="清空热键">
                                            <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                                        </Button>
                                        <Button Content="重置" Command="{Binding ResetHotkeyTopmostCommand}" ToolTipService.ToolTip="恢复默认 Ctrl+Alt+T" />
                                    </StackPanel>
                                </Grid>
                                <!-- 长久态错误(热键被占用):常驻显示,不自动消失 -->
                                <TextBlock
                                    Text="{Binding HotkeyTopmostStatusText}"
                                    FontSize="12"
                                    Foreground="#DC2626"
                                    Visibility="{Binding HasHotkeyTopmostIssue, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="剪贴板窗口快捷操作" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="8">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ctrl + 1 ~ 9" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="快速选定并直接粘贴前 9 项历史记录" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ctrl + F" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="聚焦搜索框,直接输入即可过滤条目" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="↑ / ↓" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="在候选条目间移动(呼出后自动选中最新一条)" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Enter" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="确认候选:复制并粘贴到呼出前的窗口输入框" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== 数据管理 ====== -->
                    <StackPanel x:Name="GroupData" Visibility="Collapsed" Spacing="20">
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="本地数据" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <!-- 导入 / 导出 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="ExportButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{x:Bind services:Lucide.Download}" Width="14" Height="14" />
                                            <TextBlock Text="导出数据" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ImportButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{x:Bind services:Lucide.Upload}" Width="14" Height="14" />
                                            <TextBlock Text="导入数据" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressRing IsActive="{Binding IsDataBusy}" Width="16" Height="16" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- 储存条目上限 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="储存条目上限" />
                                        <TextBlock Text="超过上限自动删除最旧条目" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="140"
                                        HorizontalAlignment="Right"
                                        ItemsSource="{Binding MaxHistoryOptions}"
                                        SelectedIndex="{Binding MaxHistoryIndex, Mode=TwoWay}" />
                                </Grid>

                                <!-- 时间上限 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="保留时长上限" />
                                        <TextBlock Text="超过期限的旧条目自动清理" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="140"
                                        HorizontalAlignment="Right"
                                        ItemsSource="{Binding RetentionDaysLabels}"
                                        SelectedIndex="{Binding RetentionDaysIndex, Mode=TwoWay}" />
                                </Grid>

                                <!-- 储存位置:标题行(右侧修改按钮) + 下一行路径 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="储存位置" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="历史数据(数据库与图片缓存)保存目录" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="ChangeStorageDir_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="选择新的储存位置">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{x:Bind services:Lucide.FolderOpen}" Width="14" Height="14" />
                                            <TextBlock Text="修改" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding ConfiguredStorageDir}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button
                                            Click="OpenDbFolder_Click"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="打开数据目录"
                                            AutomationProperties.Name="打开数据目录">
                                            <Image Source="{x:Bind services:Lucide.FolderOpen}" Width="14" Height="14" />
                                        </Button>
                                        <TextBlock
                                            Text="{Binding DataCountText}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- 清空历史 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="清空历史" />
                                        <TextBlock Text="删除全部本地历史与图片缓存(不可恢复)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="清空历史" Click="ClearHistoryButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== 关于 ====== -->
                    <StackPanel x:Name="GroupAbout" Visibility="Collapsed" Spacing="20">
                        <StackPanel Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="应用信息" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                            <StackPanel Spacing="18">

                                <!-- 应用头部:Logo + 名称 + 版本 -->
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="52" Height="52" CornerRadius="12" VerticalAlignment="Center">
                                        <Image Source="ms-appx:///Assets/icon.png" Width="52" Height="52" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="NexClip" Style="{ThemeResource TitleTextBlockStyle}" />
                                            <Border
                                                Background="{ThemeResource VersionBadgeBackground}"
                                                BorderBrush="{ThemeResource VersionBadgeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding VersionText}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource VersionBadgeForeground}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="轻量剪贴板管理 · 多端同步" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- 信息行:标签 | 值 -->
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="框架" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="WinUI 3 · .NET 9" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="自包含 x64 桌面应用" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="服务端" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="NexClip Server (node)" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="SignalR 实时同步 · REST 接口" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="数据位置" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding ConfiguredStorageDir}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="项目地址" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <HyperlinkButton Grid.Column="1" Click="OpenProject_Click" HorizontalAlignment="Left" Padding="0">
                                            <TextBlock Text="github.com/yixing233/nexclip" FontSize="13" TextWrapping="Wrap" />
                                        </HyperlinkButton>
                                    </Grid>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- 简介 -->
                                <TextBlock
                                    Text="开源跨平台剪贴板同步工具：复制内容后自动同步到多台设备，支持文本与图片，本机保留历史记录可随时检索与粘贴。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    LineHeight="20" />

                                <!-- 发现新版本提示卡片: Fluent 2 现代卡片设计, 高对比度, 支持端内下载进度与安装 -->
                                <Border
                                    Visibility="{Binding HasNewVersion, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,4,0,0">
                                    <Grid>
                                        <!-- 左侧 Accent 状态柱 -->
                                        <Border
                                            Width="4"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="10,0,0,10" />

                                        <StackPanel Spacing="14" Margin="18,16,18,16">
                                            <!-- 头部: 图标 + 发现新版本 + 版本号 + NEW 胶囊 + 通道标签 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Width="26" Height="26">
                                                        <Image Source="{x:Bind services:Lucide.SparklesWhite}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="发现新版本" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LatestVersionText}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- 右侧通道胶囊 -->
                                                <Border
                                                    Grid.Column="1"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,3"
                                                    VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UpdateSourceLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- 更新日志内容容器 (带滚动与高对比度文字) -->
                                            <Border
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12">
                                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock
                                                        Text="{Binding UpdateReleaseNotes}"
                                                        TextWrapping="Wrap"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        LineHeight="20" />
                                                </ScrollViewer>
                                            </Border>

                                            <!-- 下载进度条 (下载中可见) -->
                                            <StackPanel
                                                Spacing="6"
                                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar
                                                    Value="{Binding UpdateDownloadProgress}"
                                                    Maximum="100"
                                                    IsIndeterminate="False"
                                                    Height="6"
                                                    CornerRadius="3"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding UpdateDownloadBytesText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding UpdateDownloadSpeedText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- 操作按钮工具栏 (多状态切换) -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- 状态 A: 未下载 -> 立即下载更新 (主操作) -->
                                                <Button
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding DownloadUpdateCommand}"
                                                    Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{x:Bind services:Lucide.DownloadWhite}" Width="14" Height="14" />
                                                        <TextBlock Text="立即下载更新" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 状态 B: 下载中 -> 取消下载 -->
                                                <Button
                                                    Command="{Binding CancelDownloadUpdateCommand}"
                                                    Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{x:Bind services:Lucide.X}" Width="14" Height="14" />
                                                        <TextBlock Text="取消下载" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 状态 C: 下载完成 -> 立即安装并重启 (主操作) -->
                                                <Button
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding InstallUpdateCommand}"
                                                    Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{x:Bind services:Lucide.CheckCircleWhite}" Width="14" Height="14" />
                                                        <TextBlock Text="立即安装并重启" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 状态 C 辅助: 打开安装包目录 -->
                                                <Button
                                                    Click="OpenDownloadFolder_Click"
                                                    Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{x:Bind services:Lucide.FolderOpen}" Width="14" Height="14" />
                                                        <TextBlock Text="打开文件位置" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- 通用辅助按钮: 前往网页发布页 -->
                                                <Button Click="OpenRelease_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{x:Bind services:Lucide.ExternalLink}" Width="14" Height="14" />
                                                        <TextBlock Text="在浏览器中查看" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 操作按钮栏:检查更新 / 打开主页 / 复制信息 -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{Binding CheckUpdateCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing Width="14" Height="14" IsActive="{Binding IsCheckingUpdate}" Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{x:Bind services:Lucide.RefreshCw}" Width="14" Height="14" Visibility="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolToVis}}" />
                                            <TextBlock Text="检查更新" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenProject_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{x:Bind services:Lucide.FolderOpen}" Width="14" Height="14" />
                                            <TextBlock Text="打开项目主页" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="CopyVersionInfo_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{x:Bind services:Lucide.Copy}" Width="14" Height="14" />
                                            <TextBlock Text="复制版本信息" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Text="{Binding UpdateStatusText}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0" />
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- 统一消息提示:固定在内容区右上角,不挤压设置内容;窄窗口下自动收缩 -->
            <Grid
                x:Name="MessageHost"
                Canvas.ZIndex="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24,16,24,0"
                MaxWidth="420">
                <InfoBar
                    x:Name="SettingsMessageBar"
                    AutomationProperties.AutomationId="SettingsMessageBar"
                    AutomationProperties.LiveSetting="Polite"
                    HorizontalAlignment="Stretch"
                    IsOpen="{Binding MessageOpen, Mode=TwoWay}"
                    Severity="{Binding MessageSeverity}"
                    Message="{Binding MessageText}"
                    IsClosable="True" />
            </Grid>

        </Grid>
    </NavigationView>
</Page>
