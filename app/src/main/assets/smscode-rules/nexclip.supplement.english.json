{
  "specVersion": 1,
  "id": "nexclip.supplement.english",
  "name": "英文验证码补充规则",
  "description": "内置中文规则集(zhen.general.default)不含英文关键字，导致 'Your verification code is 556677' / 'code: 445566' / 'Your OTP is 778899' 这类短信提取不到。本补充集只覆盖英文场景，优先级低于官方中文规则不影响中文短信。",
  "locale": "en",
  "updatedAt": "2026-11-11T00:00:00+08:00",
  "rules": [
    {
      "id": "en-verification-code",
      "company": null,
      "codeKeyword": "verification code",
      "codeRegex": "(?<![a-zA-Z0-9])[0-9]{4,8}(?![a-zA-Z0-9])",
      "priority": 10,
      "rejectedSuffixes": [
        "mb",
        "gb",
        "kb",
        "tb",
        "pb",
        "byte",
        "bytes"
      ],
      "notes": "Your verification code is 556677"
    },
