<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NexClip.Desktop.Views.TransferChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:NexClip.Desktop.Converters"
    xmlns:services="using:NexClip.Desktop.Services"
    xmlns:vm="using:NexClip.Desktop.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:BoolToPillForegroundConverter x:Key="BoolToPillFg" />

        <!-- 筛选胶囊 ToggleButton 样式: 选中时高亮蓝底(#2563EB)+纯白字; 未选中时自适应卡片底色+主题文字 -->
        <Style x:Key="FilterPillStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#2563EB" />
                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">

        <!-- ====== 顶部: 在线设备选择条 ====== -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- 全部设备胶囊 -->
                        <ToggleButton
                            x:Name="SelectAllToggle"
                            Style="{StaticResource FilterPillStyle}"
                            IsChecked="{x:Bind ViewModel.SelectAllDevices, Mode=OneWay}"
                            Click="SelectAllToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                    <Image
                                        Source="{x:Bind services:Lucide.MonitorSmartphone}"
                                        Width="14"
                                        Height="14"
                                        Visibility="{x:Bind ViewModel.SelectAllDevices, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    <Image
                                        Source="{x:Bind services:Lucide.MonitorSmartphoneWhite}"
                                        Width="14"
                                        Height="14"
                                        Visibility="{x:Bind ViewModel.SelectAllDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock
                                    Text="全部设备"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind ViewModel.SelectAllDevices, Mode=OneWay, Converter={StaticResource BoolToPillFg}}" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- 各设备胶囊 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceSelectViewModel">
                                    <ToggleButton
                                        Style="{StaticResource FilterPillStyle}"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Click="DevicePill_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToPillFg}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="ClearMessages_Click" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="12" ToolTipService.ToolTip="清空互传消息">
                        <Image Source="{x:Bind services:Lucide.Trash}" Width="14" Height="14" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshDevicesCommand}" Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="12" ToolTipService.ToolTip="刷新在线设备">
                        <Image Source="{x:Bind services:Lucide.RefreshCw}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 中部: 聊天气泡消息流 ====== -->
        <ListView
            x:Name="ChatListView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Messages}"
            SelectionMode="None"
            Padding="12,12,12,12">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageItem">
                    <!-- 单条消息与跨日期分割容器 -->
                    <StackPanel Spacing="0" Margin="0,2">
                        <!-- 跨日期中间居中显示日期胶囊 -->
                        <Border
                            Visibility="{x:Bind ShowDateHeader, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,3"
                            Margin="0,8,0,10">
                            <TextBlock
                                Text="{x:Bind DateHeaderText, Mode=OneWay}"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <!-- 消息项布局: 根据 Alignment 决定靠右还是靠左 -->
                        <Grid HorizontalAlignment="{x:Bind Alignment}" Margin="0,2" MaxWidth="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 发送设备与时间 (远端消息) -->
                            <StackPanel
                                Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="5"
                                Margin="4,0,4,3"
                                HorizontalAlignment="{x:Bind Alignment}"
                                Visibility="{x:Bind FromRemoteVisibility}">
                                <TextBlock Text="{x:Bind DeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind TimeText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 气泡主体 (限制最大高度 260px，超长内容内滚) -->
                            <Border
                                Grid.Row="1"
                                CornerRadius="14"
                                Padding="{x:Bind BubblePadding}"
                                Background="{x:Bind BubbleBackground, Mode=OneWay}"
                                BorderThickness="{x:Bind BubbleThickness}"
                                BorderBrush="{x:Bind BubbleBorderBrush, Mode=OneWay}"
                                MaxHeight="260"
                                RightTapped="MessageBubble_RightTapped">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="复制" Click="CopyMessage_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="{x:Bind services:Lucide.Copy}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <StackPanel Spacing="4">
                                    <!-- 文本消息 (带内嵌滚动，超长时局部滚动) -->
                                    <ScrollViewer
                                        Visibility="{x:Bind TextVisibility}"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        MaxHeight="220">
                                        <TextBlock
                                            Text="{x:Bind Text}"
                                            TextWrapping="Wrap"
                                            FontSize="13"
                                            Foreground="{x:Bind BubbleForeground, Mode=OneWay}"
                                            IsTextSelectionEnabled="True" />
                                    </ScrollViewer>

                                    <!-- 图片消息 (点击内嵌查看器预览，限制高宽) -->
                                    <Border
                                        Visibility="{x:Bind ImageVisibility}"
                                        CornerRadius="10"
                                        Tapped="ImageBubble_Tapped">
                                        <Image
                                            Source="{x:Bind Thumbnail}"
                                            MaxHeight="180"
                                            MaxWidth="240"
                                            Stretch="Uniform" />
                                    </Border>

                                    <!-- 本机发送时间 -->
                                    <TextBlock
                                        Text="{x:Bind TimeText}"
                                        FontSize="10"
                                        HorizontalAlignment="Right"
                                        Margin="0,3,0,0"
                                        Visibility="{x:Bind FromSelfVisibility}"
                                        Foreground="{x:Bind TimeForeground, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ====== 底部: 发送栏与图片预览 ====== -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="12,8,12,10">
            <StackPanel Spacing="8">
                <!-- 选中的图片缩略图微型卡片预览 -->
                <Border
                    Visibility="{x:Bind ViewModel.HasSelectedImageVisibility, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    Padding="6,6,10,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border CornerRadius="6" Width="44" Height="44" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image Source="{x:Bind ViewModel.SelectedImageThumbnail, Mode=OneWay}" Width="44" Height="44" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="待发截图/图片" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedImageInfoText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            Command="{x:Bind ViewModel.ClearSelectedImageCommand}"
                            VerticalAlignment="Center"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Margin="4,0,0,0"
                            ToolTipService.ToolTip="移除图片附件">
                            <Image Source="{x:Bind services:Lucide.Trash}" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 输入框与按钮栏 -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <!-- 添加图片按钮 -->
                    <Button
                        x:Name="PickImageButton"
                        Click="PickImageButton_Click"
                        Padding="8,6"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        ToolTipService.ToolTip="选择图片发送 (或直接按 Ctrl+V 粘贴图片)">
                        <Image Source="{x:Bind services:Lucide.Image}" Width="18" Height="18" />
                    </Button>

                    <!-- 消息输入框 (支持 Enter / Shift+Enter 发送) -->
                    <TextBox
                        x:Name="MessageTextBox"
                        Grid.Column="1"
                        PlaceholderText="输入消息发送至设备…"
                        Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxHeight="100"
                        PreviewKeyDown="MessageTextBox_PreviewKeyDown" />

                    <!-- 发送按钮 -->
                    <Button
                        x:Name="SendButton"
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SendMessageCommand}"
                        Padding="12,6"
                        CornerRadius="6"
                        ToolTipService.ToolTip="立即发送">
                        <Button.Resources>
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#2563EB" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1D4ED8" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1E40AF" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#93C5FD" />
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FFFFFF" />
                        </Button.Resources>
                        <Image Source="{x:Bind services:Lucide.ArrowUp}" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
